{
  "description": "Zodchi: route Codex messages through Workflow Platform.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node __WORKFLOW_PLATFORM_ROOT__\\hooks\\codex-user-prompt-submit.mjs",
            "commandWindows": "node __WORKFLOW_PLATFORM_ROOT__\\hooks\\codex-user-prompt-submit.mjs",
            "timeout": 3600,
            "statusMessage": "Zodchi is processing the request"
          }
        ]
      }
    ]
  }
}
